# Arcellite Deploy configuration. Copy to .env and fill in for server mode.
# Never commit a real .env. Everything here is read on the server only; nothing is
# exposed to the browser (there are no NEXT_PUBLIC_ variables).

# Which provider the app runs:
#   mock   — the in-browser demo (default; no database, no sign-in)
#   server — the real control plane (PostgreSQL, owner account, sessions)
ARCELLITE_PROVIDER=mock

# PostgreSQL connection string (server mode, migrations, worker).
# The value below matches compose.dev.yml, which is for local development only.
DATABASE_URL=postgres://arcellite:arcellite-dev@127.0.0.1:5432/arcellite

# 32 random bytes, base64. Encrypts every environment-variable value at rest.
# Generate with: openssl rand -base64 32
# It is never stored in PostgreSQL. Back it up separately: without it, stored values
# are unrecoverable. An invalid key stops the API (503) instead of weakening encryption.
ARCELLITE_MASTER_KEY=

# Key rotation (optional): add the new key as ARCELLITE_MASTER_KEY_V2 and set the version
# used for new writes. Keep older keys so existing values still decrypt.
# ARCELLITE_MASTER_KEY_V2=
# ARCELLITE_MASTER_KEY_VERSION=1

# Public URL of this control plane. State-changing requests must come from this origin.
# Leave empty for local development: then only localhost / 127.0.0.1 origins are trusted.
ARCELLITE_APP_URL=

# Extra trusted origins, comma-separated (for example a LAN address). Rarely needed.
# ARCELLITE_TRUSTED_ORIGINS=

# NODE_ENV=production (set by `pnpm start`) makes session cookies Secure. Set this to true
# only for a plain-HTTP install on a private network; browsers already accept Secure
# cookies on http://localhost.
# ARCELLITE_INSECURE_COOKIES=false

# Database for `pnpm test:integration`. Its name must contain "test": the tests empty it.
# TEST_DATABASE_URL=postgres://arcellite:arcellite-dev@127.0.0.1:5432/arcellite_test
