# Arcellite Deploy configuration. Copy to .env and fill in for server mode.
# Never commit a real .env.

# Which provider the app runs:
#   mock   — the in-browser demo (default; no database, no sign-in)
#   server — the real control plane (PostgreSQL, owner account, sessions)
ARCELLITE_PROVIDER=mock

# PostgreSQL connection string (server mode, migrations, worker).
# Matches compose.dev.yml for local development.
DATABASE_URL=postgres://arcellite:arcellite-dev@127.0.0.1:5432/arcellite

# 32 random bytes, base64. Encrypts environment-variable values at rest.
# Generate with: openssl rand -base64 32
# Keep it outside the database and back it up separately: without it, stored values are unrecoverable.
ARCELLITE_MASTER_KEY=

# Public URL of this control plane. Requests that change state must come from this origin.
# Leave empty for local development (only localhost / 127.0.0.1 origins are trusted).
ARCELLITE_APP_URL=

# Extra trusted origins, comma-separated (rarely needed).
# ARCELLITE_TRUSTED_ORIGINS=

# Session cookies are Secure when NODE_ENV=production. Set to true only for a plain-HTTP
# install on a private network; browsers accept Secure cookies on http://localhost anyway.
# ARCELLITE_INSECURE_COOKIES=false
